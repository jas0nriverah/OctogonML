{
  "protocol": {
    "candidates": [
      "baseline_v2",
      "reliability_hgb",
      "weekly_rank_hgb",
      "blend_50",
      "weekly_blend_50"
    ],
    "prior_minutes": 30.0,
    "prior_attempts": 50.0,
    "neutral_rates": {
      "landed": 3.0,
      "absorbed": 3.0,
      "attempted": 7.0
    },
    "accuracy_prior": 0.43,
    "defense_prior": 0.57,
    "hgb": {
      "max_iter": 180,
      "max_leaf_nodes": 7,
      "min_samples_leaf": 60,
      "l2_regularization": 20.0,
      "learning_rate": 0.05,
      "early_stopping": false
    },
    "seed": 42,
    "selection": "Pooled 2021\u20132023 log loss only; unchanged V2 promotion gate against baseline_v2",
    "splits": "Train before preceding July1; calibrate July\u2013December; score next calendar year",
    "confirmation": "2024 is retrospective, already inspected; never used for selection",
    "blend": "Equal uncalibrated symmetric baseline/challenger probabilities, then independent disjoint temperature calibration",
    "weekly_rank": "Additive complete dated media board inputs, latest strictly before date; stale after35days; unknown distinct from verified absence. Live observation eligible only after retrieval, never backfilled into development.",
    "ranked_opposition": "Last5 strictly prior bouts; opponent rank frozen before that bout from dated boards only. Unknown ranks excluded. Strength=(16-rank)/16 with champion0/unranked16. Two-observation priors: strength.5,top5share0,ranked-opponent decisive winshare.5. Known-rank share=known/covered count,zero with no bouts. Draw/NC excluded from winshare denominator."
  },
  "study": {
    "development_years": [
      2021,
      2022,
      2023
    ],
    "retrospective_year": 2024,
    "retrospective_scope": "Previously inspected year; baseline and selected only after selection lock; never a selection input or untouched holdout.",
    "baseline": "baseline_v2",
    "minimum_log_loss_gain": 0.002,
    "max_ece_regression": 0.015,
    "minimum_improved_years": 2,
    "max_annual_log_loss_regression": 0.005,
    "event_bootstrap": "2000 paired event resamples, seed42; upper95 log-loss difference below zero",
    "sparse_veteran": {
      "min_prior_bouts_at_most": 3,
      "max_prior_bouts_at_least": 8,
      "minimum_n": 30,
      "max_log_loss_regression": 0.005,
      "max_brier_regression": 0.003
    },
    "all_novice": "Both athletes have at most3 prior covered bouts; diagnostic only",
    "prior_count_policy": "All canonical covered bouts strictly before event day; same-date observations excluded.",
    "deployment_train_before": "2026-07-01",
    "deployment_calibration_before": "2026-10-18",
    "immutable_outputs": "Never replace an existing different artifact or study report; use versioned output directories."
  },
