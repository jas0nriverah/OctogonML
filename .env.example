# Default is a local SQLite database under data/cagemetrics.db.
# PostgreSQL support uses psycopg 3 (install .[postgres]).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cagemetrics
# CAGEMETRICS_HOME=/absolute/path/to/cagemetrics
# PORT=8000
# auto prefers an available V3 artifact, then V2, then V1.
# Pin v1, v2, or v3 for an explicit channel/rollback; restart after changing.
# CAGEMETRICS_MODEL_CHANNEL=auto
