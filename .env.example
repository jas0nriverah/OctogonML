# Set these in the service environment. This file is a reference, not auto-loaded.
# Never commit a real API key or database credential; .env is Git-ignored.

# Default: SQLite under the selected data directory. PostgreSQL needs .[postgres].
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cagemetrics
# CAGEMETRICS_HOME=/absolute/path/to/OctogonML
# CAGEMETRICS_DATA_DIR=/absolute/path/to/data
# CAGEMETRICS_ARTIFACT_DIR=/absolute/path/to/versioned-artifacts
# CAGEMETRICS_REPORT_DIR=/absolute/path/to/versioned-reports
# PORT=8000

# Strike channels: auto prefers V3, then V2, then V1. Restart after changing.
# CAGEMETRICS_MODEL_CHANNEL=auto
# Winner is independent: auto prefers verified V2 only after its promotion gates pass.
# CAGEMETRICS_WINNER_CHANNEL=auto
# Explicit winner rollback: v1. Explicit challenger: v2.

# Optional local explanation provider. Install Ollama and pull the model separately.
CAGEMETRICS_LLM_PROVIDER=ollama
CAGEMETRICS_LLM_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
# The prepared restart script uses these only if its runtime already exists:
# CAGEMETRICS_LOCAL_LLM_DIR=/absolute/path/to/work/local-llm
# OLLAMA_MODELS=/absolute/path/to/local-model-store

# Optional future hosted provider; server-side only, never browser variables.
# CAGEMETRICS_LLM_PROVIDER=openai
# OPENAI_MODEL=your-enabled-model-id
# OPENAI_API_KEY=

# Optional integration tests require a dedicated disposable PostgreSQL database.
# CAGEMETRICS_TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cagemetrics_test
